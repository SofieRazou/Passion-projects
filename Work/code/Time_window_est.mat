function time_win = Time_window_est(E_err, lambda_d, Z, Zd)
%#codegen
% TIME_WINDOW_EST Staircase adaptive observation window estimator 
% based on Dinc et al. (IEEE TOH 2024).
%
% Generates a piecewise-constant "downward staircase" output waveform:
%   - Value updates ONLY when a valid energy cycle completion is verified 
%     by the 5-sample time window.
%   - Value remains HELD CONSTANT between cycle detections.
%
% Inputs:
%   E_err    : Accumulated energy error / net energy [J]
%   lambda_d : Desired system eigenvalue / dynamic pole
%   Z        : Current impedance estimate
%   Zd       : Target/desired impedance
%
% Output:
%   time_win : Adaptive time window / damping factor (staircase profile)

persistent E_window       % 5-sample window buffer: [E(t-2), E(t-1), E(t), E(t+1), E(t+2)]
persistent E_prev_cycle   % Energy recorded at the end of the previous cycle
persistent time_win_hold  % Persistent held value for zero-order hold staircase

%% Limits & Reference Parameters
Tmin = 0.01;              % Minimum window time [s]
Tmax = 0.50;              % Maximum window time [s]

tau_min = Tmin;
tau_max = Tmax;

Eref = 1e-3;
k_energy = 0.8;
k_impedance = 0.8;

%% Initialization
if isempty(E_window)
    E_window        = zeros(5, 1);
    E_prev_cycle    = 0.0;
    time_win_hold   = 0.50; % Initialized at upper bound (large initial correction)
end

%% 1. Maintain 5-Sample Time-Window Buffer (Fig. 4)
% Shift energy history: E(t-2) <- E(t-1) <- E(t) <- E(t+1) <- E(t+2)
E_window(1) = E_window(2);
E_window(2) = E_window(3);
E_window(3) = E_window(4);
E_window(4) = E_window(5);
E_window(5) = E_err;

%% 2. Time-Window Local Minimum Detection (Eq. 10)
% Condition: E(t-2) > E(t-1) > E(t) < E(t+1) < E(t+2)
is_cycle_detected = (E_window(1) > E_window(2)) && ...
                    (E_window(2) > E_window(3)) && ...
                    (E_window(3) < E_window(4)) && ...
                    (E_window(4) < E_window(5));

%% 3. Discrete "Staircase" Step Update at Cycle Completion (Eq. 8)
if is_cycle_detected
    % Energy at detected cycle completion (E_n)
    E_curr_cycle = E_window(3);
    
    % Generated energy over the cycle: E_gen = E_n - E_{n-1}
    E_gen = E_curr_cycle - E_prev_cycle;
    
    % System time constant base
    lambda_real = real(lambda_d);
    if lambda_real < -1e-6
        tau_c = -1/lambda_real;
    else
        tau_c = tau_max;
    end
    tau_c = min(max(tau_c, tau_min), tau_max);

    % Normalized error calculations
    energy_error    = min(abs(E_gen) / max(Eref, 1e-12), 5.0);
    impedance_error = min(norm(Z - Zd) / (norm(Zd) + 1e-12), 5.0);

    % Calculate new discrete staircase level for the upcoming cycle
    error_factor = 1.0 / (1.0 + k_energy * energy_error + k_impedance * impedance_error);
    
    % Downward step calculation as energy generation reduces
    time_candidate = tau_c * error_factor;
    
    % Update staircase held value (Zero-Order Hold for the entire next cycle)
    time_win_hold = min(max(time_candidate, Tmin), Tmax);
    
    % Store energy for next cycle comparison
    E_prev_cycle = E_curr_cycle;
end

%% 4. Zero-Order Hold Output
% Returns constant step value between cycle updates (creating downward staircase)
time_win = time_win_hold;

end


