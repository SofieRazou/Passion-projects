function time_win = Time_window_est(E_err, lambda_d, Z, Zd)
%#codegen
%
% Adaptive observation window estimator.
%
% Small window:
%   - large energy error
%   - large impedance mismatch
%   - fast-changing dynamics
%
% Large window:
%   - stable interaction
%   - small errors
%   - slow dynamics

persistent E_history
persistent history_index
persistent sample_count
persistent zcr_filtered
persistent t_prev

%% Limits
Tmin = 0.01;
Tmax = 0.50;

%% References
Eref = 1e-3;

tau_min = Tmin;
tau_max = Tmax;

history_length = 100;

%% Gains
k_energy = 0.8;
k_impedance = 0.8;
k_zcr = 1.5;

alpha_zcr = 0.05;
alpha_time = 0.25;

zero_threshold = 1e-9;


%% Initialization
if isempty(E_history)

    E_history = zeros(history_length,1);

    history_index = 1;
    sample_count = 0;

    zcr_filtered = 0;

    t_prev = 0.1;

end


%% Store energy history

E_history(history_index)=E_err;

history_index = history_index + 1;

if history_index > history_length
    history_index = 1;
end


if sample_count < history_length
    sample_count = sample_count + 1;
end



%% Zero crossing rate

zero_crossings = 0;


if sample_count > 1

    for i = 2:sample_count

        a = E_history(i-1);
        b = E_history(i);

        if ((a > zero_threshold)&&(b < -zero_threshold)) || ...
           ((a < -zero_threshold)&&(b > zero_threshold))

            zero_crossings = zero_crossings + 1;

        end

    end


    zcr_current = zero_crossings/(sample_count-1);

else

    zcr_current = 0;

end



zcr_filtered = ...
    (1-alpha_zcr)*zcr_filtered + ...
    alpha_zcr*zcr_current;



%% System time constant

lambda_real = real(lambda_d);


if lambda_real < -1e-6

    tau_c = -1/lambda_real;

else

    tau_c = tau_max;

end


tau_c = min(max(tau_c,tau_min),tau_max);



%% Normalized errors

energy_error = abs(E_err)/max(Eref,1e-12);


impedance_error = norm(Z-Zd)/(norm(Zd)+1e-12);



% Limit

energy_error = min(energy_error,5);
impedance_error = min(impedance_error,5);



%% Adaptive scaling

%
% errors reduce the window
%

error_factor = 1/(1 + ...
    k_energy*energy_error + ...
    k_impedance*impedance_error);



%
% fast variations reduce the window
%

zcr_factor = 1/(1+k_zcr*zcr_filtered);



%
% combine
%

time_candidate = tau_c * ...
    error_factor * ...
    zcr_factor;



%% Add lower bound

time_candidate = min(max(time_candidate,Tmin),Tmax);



%% Smooth output

time_win = ...
    (1-alpha_time)*t_prev + ...
    alpha_time*time_candidate;



time_win = min(max(time_win,Tmin),Tmax);


t_prev=time_win;


end



